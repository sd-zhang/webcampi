#!/bin/sh
# Persist a validated UVC settings payload to the FAT boot partition.
# Usage: isight-config-store FOV_DEGREES EV_TENTHS LOGO_MODE MIC_ENABLED
# BusyBox hush supports errexit but not nounset (-u).
set -e

# Serialize every writer without blocking the UVC event loop.
if [ "$1" = --locked ]; then shift; else
    exec /usr/bin/isight-config-lock "$0" --locked "$@"
fi
mode=camera
if [ "$1" = --audio ]; then
    shift; [ "$#" -eq 4 ] || exit 2
    mode=audio; gain=$1 hp=$2 lp=$3 bypass=$4
    case "$gain" in -[0-9]*|[0-9]*) ;; *) exit 2 ;; esac
    case "$hp:$lp:$bypass" in *[!0-9:]*) exit 2 ;; esac
    [ "$gain" -ge -240 ] && [ "$gain" -le 240 ] && [ "$((gain % 5))" -eq 0 ] || exit 2
    { [ "$hp" -eq 0 ] || { [ "$hp" -ge 20 ] && [ "$hp" -le 500 ]; }; } || exit 2
    { [ "$lp" -eq 0 ] || { [ "$lp" -ge 1000 ] && [ "$lp" -le 20000 ] && [ "$((lp % 100))" -eq 0 ]; }; } || exit 2
    case "$bypass" in 0|1) ;; *) exit 2 ;; esac
elif [ "$1" = --diagnostics ]; then
    shift; [ "$#" -eq 1 ] || exit 2
    mode=diagnostics; diagnostics=$1
    case "$diagnostics" in 0|1) ;; *) exit 2 ;; esac
else
    [ "$#" -eq 4 ] || exit 2
    fov=$1 ev_tenths=$2 logo=$3 mic=$4
    case "$fov" in ''|*[!0-9]*) exit 2 ;; esac
    case "$ev_tenths" in -[0-9]*|[0-9]*) ;; *) exit 2 ;; esac
    case "$logo" in off|on|activity) ;; *) exit 2 ;; esac
    case "$mic" in 0|1) ;; *) exit 2 ;; esac
    [ "$fov" -ge 25 ] && [ "$fov" -le 75 ] || exit 2
    [ "$ev_tenths" -ge -20 ] && [ "$ev_tenths" -le 20 ] || exit 2
fi

boot=/boot
config=$boot/isight.json
default=/etc/isight/config.default.json
grep -q " $boot " /proc/mounts || exit 1
source=$default
[ -f "$config" ] && jq -e . "$config" >/dev/null 2>&1 && source=$config

mount -o remount,rw "$boot"
tmp=$(mktemp "$boot/.isight.XXXXXX") || { mount -o remount,ro "$boot"; exit 1; }
cleanup() {
	rm -f "$tmp"
	mount -o remount,ro "$boot" || true
}
trap cleanup EXIT HUP INT TERM

case "$mode" in
 audio)
    jq --argjson gain "$gain" --argjson hp "$hp" --argjson lp "$lp" --argjson bypass "$bypass" \
       '.audio = {gain_db: ($gain / 10), highpass_hz: $hp, lowpass_hz: $lp, bypass: ($bypass == 1)}' "$source" > "$tmp" ;;
 diagnostics)
    jq --argjson enabled "$diagnostics" '.diagnostics = ($enabled == 1)' "$source" > "$tmp" ;;
 camera)
    if [ "$mic" -eq 1 ]; then mic_json=true; else mic_json=false; fi
    jq --argjson fov "$fov" --argjson ev "$ev_tenths" \
       --arg logo "$logo" --argjson mic "$mic_json" \
       '.fov = $fov | .ev = ($ev / 10) | .logo_light = $logo | .microphone = $mic' \
       "$source" > "$tmp" ;;
esac

jq -e . "$tmp" >/dev/null
mv -f "$tmp" "$config"
mount -o remount,ro "$boot"
trap - EXIT HUP INT TERM
