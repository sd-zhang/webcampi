#!/bin/sh

DAEMON="uvc-gadget"
PIDFILE="/var/run/$DAEMON.pid"
SETUP="/usr/local/bin/uvc-gadget.sh"

UVC_GADGET_ARGS=""

[ -r "/etc/default/$DAEMON" ] && . "/etc/default/$DAEMON"

start() {
	printf 'Starting %s: ' "$DAEMON"

	# Apply persisted config (isight.json on the FAT boot partition) into the
	# environment: the gadget setup reads resolution/mic settings; the daemon
	# reads FOV, EV and logo defaults. Missing config falls back to defaults and
	# never blocks the camera.
	sh -x /usr/bin/isight-config-apply > /tmp/isight-config-apply.log 2>&1
	if [ -f /run/isight.env ]; then
		. /run/isight.env
		# BusyBox hush has no `set -a`; export the known settings explicitly.
		export ISIGHT_RESOLUTIONS ISIGHT_FOV ISIGHT_EV ISIGHT_LOGO
		export ISIGHT_QUALITY ISIGHT_MICROPHONE ISIGHT_AUDIO ISIGHT_DIAGNOSTICS
	fi

	if ! sh "$SETUP" start > /tmp/uvc-setup.log 2>&1; then
		echo "FAIL"
		return 1
	fi
	# ConfigFS assigns extension unit IDs; pass the actual value to userspace.
	xu_id=/sys/kernel/config/usb_gadget/g1/functions/uvc.0/control/extensions/xu.0/bUnitID
	if [ -r "$xu_id" ]; then
		ISIGHT_XU_UNIT=$(cat "$xu_id")
		export ISIGHT_XU_UNIT
	fi

	# Run the daemon backgrounded, but capture its stdout/stderr to a log
	# readable on the Pi for UVC Probe/Commit/STREAMON diagnostics.
	# Functional behaviour is unchanged; only the output
	# destination differs from the previous start-stop-daemon --background,
	# which discarded the daemon's output to /dev/null. The daemon runs in
	# the foreground (no self-daemonize), so $! is its real PID.
	"/usr/bin/$DAEMON" -c 0 uvc.0 -p "23 24" -S $UVC_GADGET_ARGS \
		< /dev/null > /tmp/uvc-gadget.log 2>&1 &
	echo $! > "$PIDFILE"

	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf 'Stopping %s: ' "$DAEMON"

	sh "$SETUP" stop > /dev/null 2>&1

	start-stop-daemon --stop --quiet \
		--pidfile "$PIDFILE"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	rm -f "$PIDFILE"
	return "$status"
}

restart() {
	stop
	start
}


case "$1" in
	start|stop|restart)
		"$1";;
	reload)
		restart;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
