@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef DWC2_ISOC_DIAG_H
+#define DWC2_ISOC_DIAG_H
+
+/* An upper bound on current microframe age, not an event timestamp.
+ * Requires live adjacent HS frame reads in one uninterrupted bus epoch.
+ * Leave 10 us margin below the earliest configured EOPF. */
+static inline bool dwc2_diag_before_eopf(bool valid, u32 previous, u64 before,
+				       u32 current_frame, u64 after, u32 dcfg)
+{
+	u64 cutoff = 90000 + 6250 * ((dcfg >> 11) & 3);
+
+	return valid && (((previous + 1) & 0x3fff) == current_frame) &&
+	       after >= before && after - before < cutoff;
+}
+
+struct dwc2_diag_arm {
+	u32 serial, target, before_frame, after_frame, length;
+};
+
+struct dwc2_diag_decision {
+	u64 ns, previous_ns;
+	u32 previous_frame, entry_frame, live, cached, target;
+	u32 epctrl, epint, epsize, dcfg, session, ep, status;
+	bool before_eopf;
+	struct dwc2_diag_arm arm;
+};
+
+struct dwc2_irq_diag {
+	u64 last_ns, previous_ns, probe_ns, handler_ns;
+	u32 entries, handler_max_ns, in_passes, out_passes, incomplete_only;
+	u32 last_frame, previous_frame, entry_frame, dcfg;
+	u32 passes, incomplete, before_eopf, selected, selected_early;
+	u32 adjacent, selected_current, selected_current_adjacent;
+	u32 waiting[16], decisions[16], nak[16], complete[16];
+	bool last_valid, current_valid;
+	unsigned int sample_count, early_count;
+	struct dwc2_diag_decision samples[8], early_samples[8];
+};
+#endif
