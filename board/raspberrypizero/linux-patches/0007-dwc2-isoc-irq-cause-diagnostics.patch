 /* Read-only lifetime counters. Retain them across stream reopens so a
  * periodic logger cannot miss a short session. Never format in IRQ context. */
+static void dwc2_diag_show_decision(struct seq_file *seq, const char *kind,
+				    const struct dwc2_diag_decision *s)
+{
+	seq_printf(seq, "irq_decision %s ep=%u session=%u ns=%llu previous_ns=%llu previous_frame=%u entry_frame=%u live=%u cached=%u target=%u ctrl=%#x epint=%#x epsize=%#x dcfg=%#x status=%#x before_eopf=%u arm_serial=%u arm_target=%u arm_before=%u arm_after=%u arm_length=%u\n",
+		   kind, s->ep, s->session, (unsigned long long)s->ns,
+		   (unsigned long long)s->previous_ns, s->previous_frame,
+		   s->entry_frame, s->live, s->cached, s->target, s->epctrl,
+		   s->epint, s->epsize, s->dcfg, s->status, s->before_eopf,
+		   s->arm.serial, s->arm.target, s->arm.before_frame,
+		   s->arm.after_frame, s->arm.length);
+}
+
+static int dwc2_diag_show_irq(struct seq_file *seq, struct dwc2_hsotg *hsotg)
+{
+	struct dwc2_irq_diag *d;
+	unsigned long flags;
+	unsigned int i;
+
+	d = kmalloc(sizeof(*d), GFP_KERNEL);
+	if (!d)
+		return -ENOMEM;
+	spin_lock_irqsave(&hsotg->lock, flags);
+	*d = hsotg->irq_diag;
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+	seq_printf(seq, "irq_causes passes=%u incomplete=%u before_eopf=%u selected=%u selected_early=%u probe_ns=%llu\n",
+		   d->passes, d->incomplete, d->before_eopf, d->selected,
+		   d->selected_early, (unsigned long long)d->probe_ns);
+	seq_printf(seq, "irq_work entries=%u in_passes=%u out_passes=%u incomplete_only=%u handler_ns=%llu handler_max_ns=%u\n",
+		   d->entries, d->in_passes, d->out_passes, d->incomplete_only,
+		   (unsigned long long)d->handler_ns, d->handler_max_ns);
+	seq_printf(seq, "irq_coverage adjacent=%u selected_current=%u selected_current_adjacent=%u\n",
+		   d->adjacent, d->selected_current, d->selected_current_adjacent);
+	for (i = 1; i < ARRAY_SIZE(d->waiting); i++) {
+		if (d->waiting[i] || d->decisions[i] || d->nak[i] || d->complete[i])
+			seq_printf(seq, "irq_endpoint ep=%u waiting=%u selected=%u nak=%u complete=%u\n",
+				   i, d->waiting[i], d->decisions[i], d->nak[i], d->complete[i]);
+	}
+	for (i = 0; i < d->sample_count; i++)
+		dwc2_diag_show_decision(seq, "first", &d->samples[i]);
+	for (i = 0; i < d->early_count; i++)
+		dwc2_diag_show_decision(seq, "early", &d->early_samples[i]);
+	kfree(d);
+	return 0;
+}
