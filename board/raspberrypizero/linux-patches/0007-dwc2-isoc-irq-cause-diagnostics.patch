+/* Diagnostic only: no policy changes, allocation, or printing in IRQ. */
+static void dwc2_diag_irq_snapshot(struct dwc2_hsotg *hsotg, u32 status, u32 mask)
+{
+	struct dwc2_irq_diag *d = &hsotg->irq_diag;
+	u64 before = ktime_get_ns();
+	u32 dsts = dwc2_readl(hsotg, DSTS);
+	u32 frame = (dsts & DSTS_SOFFN_MASK) >> DSTS_SOFFN_SHIFT;
+	u64 after = ktime_get_ns();
+	bool valid = hsotg->gadget.speed == USB_SPEED_HIGH &&
+		     hsotg->lx_state == DWC2_L0 && !hsotg->bus_suspended &&
+		     !(dsts & (DSTS_SUSPSTS | DSTS_ERRATICERR)) &&
+		     using_dma(hsotg) && !using_desc_dma(hsotg) &&
+		     !(status & (GINTSTS_USBRST | GINTSTS_RESETDET |
+				 GINTSTS_ENUMDONE | GINTSTS_USBSUSP |
+				 GINTSTS_WKUPINT | GINTSTS_DISCONNINT));
+
+	d->passes++;
+	if (status & mask & GINTSTS_IEPINT)
+		d->in_passes++;
+	if (status & mask & GINTSTS_OEPINT)
+		d->out_passes++;
+	d->probe_ns += after - before;
+	d->previous_ns = d->last_ns;
+	d->previous_frame = d->last_frame;
+	d->entry_frame = frame;
+	d->current_valid = valid && d->last_valid;
+	if (d->current_valid && (((d->previous_frame + 1) & 0x3fff) == frame))
+		d->adjacent++;
+	d->last_valid = valid;
+	d->last_ns = before;
+	d->last_frame = frame;
+	if (status & mask & GINTSTS_INCOMPL_SOIN) {
+		if (!(status & mask & (GINTSTS_IEPINT | GINTSTS_OEPINT)))
+			d->incomplete_only++;
+		d->incomplete++;
+		d->dcfg = dwc2_readl(hsotg, DCFG);
+		if (dwc2_diag_before_eopf(d->current_valid, d->previous_frame,
+					d->previous_ns, frame, after, d->dcfg))
+			d->before_eopf++;
+	}
+}
+
+static void dwc2_diag_disable_decision(struct dwc2_hsotg *hsotg,
+				      struct dwc2_hsotg_ep *ep, u32 ctrl)
+{
+	struct dwc2_irq_diag *d = &hsotg->irq_diag;
+	struct dwc2_diag_decision s = { 0 };
+	u32 dsts;
+	bool valid;
+
+	d->selected++;
+	d->decisions[ep->index]++;
+	s.previous_ns = d->previous_ns;
+	s.previous_frame = d->previous_frame;
+	s.entry_frame = d->entry_frame;
+	s.cached = hsotg->frame_number;
+	s.target = ep->target_frame;
+	s.epctrl = ctrl;
+	s.epint = dwc2_readl(hsotg, DIEPINT(ep->index));
+	s.epsize = dwc2_readl(hsotg, DIEPTSIZ(ep->index));
+	dsts = dwc2_readl(hsotg, DSTS);
+	s.live = (dsts & DSTS_SOFFN_MASK) >> DSTS_SOFFN_SHIFT;
+	s.status = dwc2_readl(hsotg, GINTSTS);
+	s.ns = ktime_get_ns();
+	s.dcfg = d->dcfg;
+	s.ep = ep->index;
+	s.session = ep->diag_sessions;
+	s.arm = ep->diag_arm;
+	valid = d->current_valid && hsotg->gadget.speed == USB_SPEED_HIGH &&
+		hsotg->lx_state == DWC2_L0 && !hsotg->bus_suspended &&
+		!(dsts & (DSTS_SUSPSTS | DSTS_ERRATICERR)) &&
+		!(s.status & (GINTSTS_USBRST | GINTSTS_RESETDET |
+			      GINTSTS_ENUMDONE | GINTSTS_USBSUSP |
+			      GINTSTS_WKUPINT | GINTSTS_DISCONNINT));
+	if (s.target == s.live) {
+		d->selected_current++;
+		if (valid && s.live == d->entry_frame &&
+		    (((d->previous_frame + 1) & 0x3fff) == s.live))
+			d->selected_current_adjacent++;
+	}
+	s.before_eopf = valid && s.live == d->entry_frame &&
+		dwc2_diag_before_eopf(d->current_valid, d->previous_frame,
+				     d->previous_ns, s.live, s.ns, s.dcfg);
+	if (s.before_eopf && s.target == s.live) {
+		d->selected_early++;
+		if (d->early_count < ARRAY_SIZE(d->early_samples))
+			d->early_samples[d->early_count++] = s;
+	}
+	if (d->sample_count < ARRAY_SIZE(d->samples))
+		d->samples[d->sample_count++] = s;
 }
 
