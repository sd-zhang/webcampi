+
+/* The arm serial and session distinguish reused request storage. */
+static bool dwc2_isoc_deferred_matches(struct dwc2_hsotg *hsotg,
+				      struct dwc2_hsotg_ep *ep)
+{
+	return ep->deferred.valid && ep->req &&
+		ep->deferred.serial == ep->diag_arm.serial &&
+		ep->deferred.session == ep->diag_sessions &&
+		ep->deferred.target == ep->diag_arm.target &&
+		ep->deferred.epoch == hsotg->irq_diag.recovery_epoch;
+}
+
+static bool dwc2_isoc_deferred_elapsed(struct dwc2_hsotg *hsotg,
+				      struct dwc2_hsotg_ep *ep,
+				      u32 frame, u64 ns)
+{
+	u32 delta;
+
+	if (!dwc2_isoc_deferred_matches(hsotg, ep) ||
+	    !hsotg->irq_diag.current_valid ||
+	    ep->target_frame != ep->deferred.target) {
+		ep->deferred.valid = false;
+		return false;
+	}
+	delta = (frame - ep->deferred.target) & 0x3fff;
+	/* Unlike frame_overrun, this also covers a target at 16383 serviced
+	 * after SOF 0. A long delay of the identical request is unambiguous
+	 * even after a full counter wrap: 250 us exceeds a HS microframe.
+	 * Epoch validation excludes reset/suspend/re-enumeration. */
+	return (delta && delta < 0x2000) ||
+		(ns >= ep->deferred.ns && ns - ep->deferred.ns > 250000);
+}
+
+static bool dwc2_isoc_ack_before_eopf(struct dwc2_hsotg *hsotg,
+				     u32 *frame, u64 *ns)
+{
+	struct dwc2_irq_diag *d = &hsotg->irq_diag;
+	u32 status, dsts;
+	bool valid;
+
+	/* Clear the sampled cause before measuring its age. Readback orders
+	 * the W1C before the frame/time observations. Never clear at exit:
+	 * a genuine new EOPF may arrive while scanning endpoints. */
+	dwc2_writel(hsotg, GINTSTS_INCOMPL_SOIN, GINTSTS);
+	status = dwc2_readl(hsotg, GINTSTS);
+	dsts = dwc2_readl(hsotg, DSTS);
+	*frame = (dsts & DSTS_SOFFN_MASK) >> DSTS_SOFFN_SHIFT;
+	*ns = ktime_get_ns();
+	valid = dwc2_isoc_epoch_valid(hsotg, dsts, status);
+	if (!valid) {
+		d->recovery_epoch++;
+		d->current_valid = false;
+		d->last_valid = false;
+	}
+	return valid && !(status & GINTSTS_INCOMPL_SOIN) &&
+		*frame == d->entry_frame &&
+		dwc2_diag_before_eopf(d->current_valid, d->previous_frame,
+				     d->previous_ns, *frame, *ns, d->dcfg);
 }
 
