+/* Read-only lifetime counters. Retain them across stream reopens so a
+ * periodic logger cannot miss a short session. Never format in IRQ context. */
+static int isoc_stats_show(struct seq_file *seq, void *v)
+{
+	struct dwc2_hsotg *hsotg = seq->private;
+	static const char * const names[] = { "start", "disabled", "out-token", "nak" };
+	static const char * const labels[] = { "first_burst", "last_burst", "worst_burst" };
+	unsigned int index, direction, i, j;
+	unsigned long flags;
+
+	for (direction = 0; direction < 2; ++direction) {
+		for (index = 1; index < hsotg->num_of_eps; ++index) {
+			struct dwc2_hsotg_ep *ep = direction ?
+				hsotg->eps_in[index] : hsotg->eps_out[index];
+			struct dwc2_isoc_diag saved[4];
+			u32 sessions;
+			u16 interval;
+			bool dma, ddma;
+
+			if (!ep)
+				continue;
+			spin_lock_irqsave(&hsotg->lock, flags);
+			sessions = ep->diag_sessions;
+			interval = ep->interval;
+			dma = hsotg->params.g_dma;
+			ddma = hsotg->params.g_dma_desc;
+			memcpy(saved, ep->isoc_diag, sizeof(saved));
+			spin_unlock_irqrestore(&hsotg->lock, flags);
+			if (!sessions)
+				continue;
+			seq_printf(seq, "%s sessions=%u interval=%u dma=%u ddma=%u\n",
+				   ep->ep.name, sessions, interval, dma, ddma);
+			for (i = 0; i < 4; ++i) {
+				struct dwc2_isoc_diag *d = &saved[i];
+				const struct dwc2_isoc_diag_sample *samples[] = {
+					&d->first, &d->last, &d->worst
+				};
+
+				seq_printf(seq, "%s %s missed=%u payload=%u max_burst=%u\n",
+					   ep->ep.name, names[i], d->missed, d->payload,
+					   d->max_burst);
+				if (!d->missed)
+					continue;
+				for (j = 0; j < 3; ++j) {
+					const struct dwc2_isoc_diag_sample *sample = samples[j];
+
+					seq_printf(seq, "%s %s %s ns=%llu session=%u cached=%u live=%u target=%u overrun=%u last_irq=%#x\n",
+						   ep->ep.name, names[i], labels[j],
+						   (unsigned long long)sample->ns, sample->session,
+						   sample->cached, sample->live, sample->target,
+						   sample->overrun, sample->irq);
+				}
+			}
+		}
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(isoc_stats);
+
