+/* reason: 0=start, 1=disabled, 2=out-token, 3=NAK. No printk in IRQ
+ * recovery. Sample clocks only at the first drop in each recovery pass. */
+static void dwc2_isoc_diag_miss(struct dwc2_hsotg_ep *ep, unsigned int reason,
+			       u32 burst, struct dwc2_hsotg_req *req)
+{
+	struct dwc2_isoc_diag *d = &ep->isoc_diag[reason];
+
+	if (burst == 1) {
+		d->worst_updated = false;
+		d->last.ns = ktime_get_ns();
+		d->last.cached = ep->parent->frame_number;
+		d->last.live = dwc2_hsotg_read_frameno(ep->parent);
+		d->last.target = ep->target_frame;
+		d->last.overrun = ep->frame_overrun;
+		d->last.irq = ep->diag_irq;
+		d->last.session = ep->diag_sessions;
+		if (!d->missed)
+			d->first = d->last;
+	}
+	d->missed++;
+	if (req->req.length)
+		d->payload++;
+	if (burst > d->max_burst) {
+		d->max_burst = burst;
+		if (!d->worst_updated) {
+			d->worst = d->last;
+			d->worst_updated = true;
+		}
+	}
+}
