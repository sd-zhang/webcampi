 /* Prepared requests retain DMA ownership; only EPENA is postponed. */
 static void dwc2_isoc_arm_cancel(struct dwc2_hsotg_ep *ep)
 {
-	if (ep->arm.pending)
+	bool waiting = ep->arm.waiting_sof;
+
+	if (ep->arm.pending || waiting)
 		ep->arm.cancelled++;
 	ep->arm.pending = false;
+	ep->arm.waiting_sof = false;
 	ep->arm.prepared = false;
+	if (waiting)
+		dwc2_isoc_sof_sync(ep->parent);
 	if (ep->arm.initialized)
 		hrtimer_try_to_cancel(&ep->arm.timer);
 }
@@ -1245,12 +1280,14 @@
 
 		if (!ep || !ep->arm.initialized)
 			continue;
-		if (ep->arm.pending)
+		if (ep->arm.pending || ep->arm.waiting_sof)
 			ep->arm.cancelled++;
 		ep->arm.pending = false;
+		ep->arm.waiting_sof = false;
 		/* Keep prepared until completion: hardware was never enabled. */
 		hrtimer_try_to_cancel(&ep->arm.timer);
 	}
+	dwc2_isoc_sof_sync(hsotg);
 }
 
 static bool dwc2_isoc_arm_expired(struct dwc2_hsotg_ep *ep)
