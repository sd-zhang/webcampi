+/* Device SOF interrupts are owned only while a prepared request awaits its
+ * preceding microframe. Ordinary video completion never calls this helper. */
+static void dwc2_isoc_sof_sync(struct dwc2_hsotg *hsotg)
+{
+	bool needed = false;
+	unsigned int i;
+	u32 mask;
+
+	for (i = 1; i < hsotg->num_of_eps; i++)
+		if (hsotg->eps_in[i] && hsotg->eps_in[i]->arm.waiting_sof)
+			needed = true;
+	if (needed == hsotg->arm_sof_enabled)
+		return;
+	/* Clock/power teardown invalidates ownership before registers vanish.
+	 * A role transition must not modify the host's SOF interrupt mask. */
+	if (!hsotg->ll_hw_enabled || hsotg->hibernated || hsotg->in_ppd ||
+	    hsotg->bus_suspended || hsotg->lx_state != DWC2_L0 ||
+	    dwc2_readl(hsotg, GINTSTS) & GINTSTS_CURMODE_HOST) {
+		hsotg->arm_sof_enabled = false;
+		return;
+	}
+	mask = dwc2_readl(hsotg, GINTMSK);
+	if (needed)
+		mask |= GINTSTS_SOF;
+	else
+		mask &= ~GINTSTS_SOF;
+	dwc2_writel(hsotg, mask, GINTMSK);
+	hsotg->arm_sof_enabled = needed;
+}
