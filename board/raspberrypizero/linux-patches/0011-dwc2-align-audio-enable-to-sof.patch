 	struct hrtimer timer;
 	struct dwc2_hsotg_req *request;
-	bool initialized, prepared, pending;
+	bool initialized, prepared, pending, waiting_sof;
 	u32 target, session, epoch;
 	u64 started_ns, deadline_ns;
 	u64 scheduled, armed, late, early, cancelled, lateness_ns_max, resync;
 	u64 callbacks, callback_ns, callback_ns_max;
+	u64 sof_waits, sof_callbacks, sof_armed;
