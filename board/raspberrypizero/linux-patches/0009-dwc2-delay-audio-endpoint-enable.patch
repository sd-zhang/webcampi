+/* Prepared requests retain DMA ownership; only EPENA is postponed. */
+static void dwc2_isoc_arm_cancel(struct dwc2_hsotg_ep *ep)
+{
+	if (ep->arm.pending)
+		ep->arm.cancelled++;
+	ep->arm.pending = false;
+	ep->arm.prepared = false;
+	if (ep->arm.initialized)
+		hrtimer_try_to_cancel(&ep->arm.timer);
+}
+
+/* Called under hsotg->lock before reset or power-state changes. */
+void dwc2_gadget_cancel_isoc_arming(struct dwc2_hsotg *hsotg)
+{
+	unsigned int i;
+
+	hsotg->arm_epoch++;
+	for (i = 1; i < hsotg->num_of_eps; i++) {
+		struct dwc2_hsotg_ep *ep = hsotg->eps_in[i];
+
+		if (!ep || !ep->arm.initialized)
+			continue;
+		if (ep->arm.pending)
+			ep->arm.cancelled++;
+		ep->arm.pending = false;
+		/* Keep prepared until completion: hardware was never enabled. */
+		hrtimer_try_to_cancel(&ep->arm.timer);
+	}
+}
+
+static bool dwc2_isoc_arm_expired(struct dwc2_hsotg_ep *ep)
+{
+	u32 distance;
+	u64 now;
+
+	if (!ep->arm.prepared || !ep->req ||
+	    ep->arm.request != ep->req ||
+	    ep->arm.target != ep->target_frame ||
+	    ep->arm.session != ep->diag_sessions)
+		return false;
+	distance = (ep->target_frame - ep->parent->frame_number) &
+		   DSTS_SOFFN_LIMIT;
+	now = ktime_get_ns();
+	/* A delayed callback must not confuse an entire counter wrap with future. */
+	return !distance || distance >= 0x2000 ||
+	       (now >= ep->arm.started_ns &&
+		now - ep->arm.started_ns >= 2000000);
+}
+
+static void dwc2_isoc_write_epena(struct dwc2_hsotg_ep *ep, u32 ctrl)
+{
+	struct dwc2_hsotg *hsotg = ep->parent;
+	u32 reg = ep->dir_in ? DIEPCTL(ep->index) : DOEPCTL(ep->index);
+
+	if (ep->arm.prepared) {
+		ep->arm.armed++;
+		ep->arm.prepared = false;
+		ep->arm.pending = false;
+	}
+	if (ep->isochronous && ep->dir_in) {
+		ep->diag_arm.serial++;
+		ep->diag_arm.target = ep->target_frame;
+		ep->diag_arm.length = ep->size_loaded;
+		ep->diag_arm.before_frame = dwc2_hsotg_read_frameno(hsotg);
+	}
+	dwc2_writel(hsotg, ctrl, reg);
+	if (ep->isochronous && ep->dir_in)
+		ep->diag_arm.after_frame = dwc2_hsotg_read_frameno(hsotg);
+}
+
+static enum hrtimer_restart dwc2_isoc_arm_timer(struct hrtimer *timer)
+{
+	struct dwc2_isoc_arm *arm = container_of(timer, struct dwc2_isoc_arm,
+					       timer);
+	struct dwc2_hsotg_ep *ep = container_of(arm, struct dwc2_hsotg_ep, arm);
+	struct dwc2_hsotg *hsotg = ep->parent;
+	unsigned long flags;
+	u64 entered_ns = ktime_get_ns();
+	u64 now, elapsed;
+	u32 ctrl, dsts, status, distance;
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	arm->callbacks++;
+	if (!arm->pending)
+		goto out;
+	now = ktime_get_ns();
+	/* A previous callback may have waited while a replacement was queued. */
+	if (now < arm->deadline_ns)
+		goto out;
+	arm->pending = false;
+	arm->lateness_ns_max = max(arm->lateness_ns_max,
+				   now - arm->deadline_ns);
+	/* Never read registers when software already knows clocks are off. */
+	if (!hsotg->ll_hw_enabled || hsotg->hibernated || hsotg->in_ppd ||
+	    hsotg->bus_suspended || hsotg->lx_state != DWC2_L0 ||
+	    !arm->prepared || !ep->req || arm->request != ep->req ||
+	    arm->session != ep->diag_sessions ||
+	    arm->target != ep->target_frame || arm->epoch != hsotg->arm_epoch)
+		goto out;
+	status = dwc2_readl(hsotg, GINTSTS);
+	dsts = dwc2_readl(hsotg, DSTS);
+	if (!dwc2_isoc_epoch_valid(hsotg, dsts, status) ||
+	    status & (GINTSTS_CURMODE_HOST | GINTSTS_LPMTRANRCVD))
+		goto out;
+	hsotg->frame_number = (dsts & DSTS_SOFFN_MASK) >> DSTS_SOFFN_SHIFT;
+	if (dwc2_isoc_arm_expired(ep)) {
+		arm->late++;
+		/* Host NAK recovery owns retirement, including PCM consumption. */
+		goto out;
+	}
+	ctrl = dwc2_readl(hsotg, DIEPCTL(ep->index));
+	if (!(ctrl & DXEPCTL_USBACTEP) ||
+	    ctrl & (DXEPCTL_EPENA | DXEPCTL_STALL))
+		goto out;
+	if (dwc2_readl(hsotg, DIEPINT(ep->index)) &
+	    (DXEPINT_NAKINTRPT | DXEPINT_EPDISBLD | DXEPINT_XFERCOMPL))
+		goto out;
+	/* The register checks above can straddle SOF or a bus transition. */
+	status = dwc2_readl(hsotg, GINTSTS);
+	dsts = dwc2_readl(hsotg, DSTS);
+	if (!dwc2_isoc_epoch_valid(hsotg, dsts, status) ||
+	    status & (GINTSTS_CURMODE_HOST | GINTSTS_LPMTRANRCVD))
+		goto out;
+	hsotg->frame_number = (dsts & DSTS_SOFFN_MASK) >> DSTS_SOFFN_SHIFT;
+	if (dwc2_isoc_arm_expired(ep)) {
+		arm->late++;
+		goto out;
+	}
+	distance = (ep->target_frame - hsotg->frame_number) & DSTS_SOFFN_LIMIT;
+	if (distance > 3)
+		arm->early++;
+	/* Use live control bits; do not replay a saved register snapshot. */
+	ctrl &= ~(DXEPCTL_EPDIS | DXEPCTL_SNAK);
+	ctrl |= DXEPCTL_EPENA | DXEPCTL_CNAK;
+	dwc2_isoc_write_epena(ep, ctrl);
+out:
+	elapsed = ktime_get_ns() - entered_ns;
+	arm->callback_ns += elapsed;
+	arm->callback_ns_max = max(arm->callback_ns_max, elapsed);
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+	return HRTIMER_NORESTART;
+}
+
+static bool dwc2_isoc_prepare_arm(struct dwc2_hsotg_ep *ep)
+{
+	struct dwc2_hsotg *hsotg = ep->parent;
+	struct dwc2_isoc_arm *arm = &ep->arm;
+	u32 distance, frame;
+	u64 now;
+
+	if (!arm->initialized || !hrtimer_is_hres_active(&arm->timer) ||
+	    !ep->isochronous || !ep->dir_in || ep->interval != 8 ||
+	    hsotg->gadget.speed != USB_SPEED_HIGH || !using_dma(hsotg) ||
+	    using_desc_dma(hsotg) || !hsotg->ll_hw_enabled ||
+	    hsotg->lx_state != DWC2_L0 || hsotg->bus_suspended ||
+	    hsotg->hibernated || hsotg->in_ppd)
+		return false;
+	frame = dwc2_hsotg_read_frameno(hsotg);
+	now = ktime_get_ns();
+	distance = (ep->target_frame - frame) & DSTS_SOFFN_LIMIT;
+	if (distance <= 3 || distance > 8 ||
+	    dwc2_readl(hsotg, DIEPCTL(ep->index)) & DXEPCTL_EPENA)
+		return false;
+	arm->request = ep->req;
+	arm->target = ep->target_frame;
+	arm->session = ep->diag_sessions;
+	arm->epoch = hsotg->arm_epoch;
+	arm->started_ns = now;
+	arm->deadline_ns = now + (distance - 3) * 125000ULL;
+	arm->prepared = true;
+	arm->pending = true;
+	arm->scheduled++;
+	hrtimer_start(&arm->timer, ns_to_ktime(arm->deadline_ns),
+		      HRTIMER_MODE_ABS_PINNED);
+	return true;
+}
