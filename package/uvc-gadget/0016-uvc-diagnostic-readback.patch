+++ b/lib/pisight-diagnostic.h
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PISIGHT_DIAGNOSTIC_H
+#define PISIGHT_DIAGNOSTIC_H
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define PISIGHT_DIAG_MAX (4U * 1024U * 1024U)
+
+/* Selector 2: fixed 60-byte commands/responses. Never writes target files. */
+struct pisight_diagnostic {
+	uint8_t *data;
+	uint32_t size, offset, generation;
+	uint8_t status;
+};
+static inline uint32_t pisight_diag_u32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+		(uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+static inline void pisight_diag_put32(uint8_t *p, uint32_t v)
+{
+	for (unsigned int i = 0; i < 4; ++i)
+		p[i] = v >> (8 * i);
+}
+static inline void pisight_diag_close(struct pisight_diagnostic *d)
+{
+	free(d->data);
+	d->data = NULL;
+	d->size = d->offset = 0;
+	d->status = 1; /* no snapshot */
+}
+static inline void pisight_diag_command(struct pisight_diagnostic *d,
+		const uint8_t *p, int length, const char *const paths[2])
+{
+	uint32_t generation, offset;
+	FILE *f;
+	size_t size;
+
+	d->status = 4; /* invalid request or stale generation */
+	if (length != 60 || p[0] != 1 || p[2] > 1 || p[3])
+		return;
+	for (unsigned int i = 12; i < 60; ++i)
+		if (p[i])
+			return;
+	generation = pisight_diag_u32(p + 4);
+	offset = pisight_diag_u32(p + 8);
+	if (p[1] == 2) { /* select an absolute offset; GET_CUR is idempotent */
+		if (p[2] || !d->data || generation != d->generation)
+			return;
+		if (offset > d->size) {
+			d->status = 3;
+			return;
+		}
+		d->offset = offset;
+		d->status = 0;
+		return;
+	}
+	if (generation || offset || (p[1] != 1 && p[1] != 3))
+		return;
+	if (p[1] == 3 && p[2])
+		return;
+	pisight_diag_close(d);
+	if (p[1] == 3)
+		return;
+	/* Capture a bounded immutable copy, including debugfs files of size 0.
+	 * The host normally requests it after stopping A/V capture. */
+	f = fopen(paths[p[2]], "rb");
+	if (!f) {
+		d->status = 2;
+		return;
+	}
+	d->data = malloc(PISIGHT_DIAG_MAX);
+	if (!d->data) {
+		fclose(f);
+		d->status = 6;
+		return;
+	}
+	size = fread(d->data, 1, PISIGHT_DIAG_MAX, f);
+	int extra = size == PISIGHT_DIAG_MAX ? fgetc(f) : EOF;
+	int failed = ferror(f);
+	fclose(f);
+	if (failed || extra != EOF) {
+		pisight_diag_close(d);
+		d->status = failed ? 2 : 5;
+		return;
+	}
+	d->size = size;
+	if (!++d->generation)
+		++d->generation;
+	d->status = 0;
+}
+static inline void pisight_diag_read(const struct pisight_diagnostic *d,
+				    uint8_t out[60])
+{
+	memset(out, 0, 60);
+	out[0] = 1;
+	out[1] = d->status ? d->status : (d->data ? 0 : 1);
+	pisight_diag_put32(out + 4, d->generation);
+	pisight_diag_put32(out + 8, d->size);
+	pisight_diag_put32(out + 12, d->offset);
+	if (out[1])
+		return;
+	uint32_t remaining = d->size - d->offset;
+	out[2] = remaining < 44 ? remaining : 44;
+	out[3] = remaining <= 44;
+	memcpy(out + 16, d->data + d->offset, out[2]);
+}
+#endif
--- a/scripts/uvc-gadget.sh
+++ b/scripts/uvc-gadget.sh
@@ -112,8 +112,9 @@
