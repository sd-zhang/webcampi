#!/bin/sh

DAEMON="uvc-gadget"
PIDFILE="/var/run/$DAEMON.pid"
SETUP="/usr/local/bin/uvc-gadget.sh"

UVC_GADGET_ARGS=""

[ -r "/etc/default/$DAEMON" ] && . "/etc/default/$DAEMON"

start() {
	printf 'Starting %s: ' "$DAEMON"

	# Apply persisted config (config.json on the FAT boot partition) into the
	# environment: the gadget setup reads ISIGHT_RESOLUTIONS, the daemon reads
	# ISIGHT_FOV. Best-effort; missing/invalid config falls back to defaults and
	# never blocks the camera.
	isight-config-apply 2>/dev/null
	[ -f /run/isight.env ] && { set -a; . /run/isight.env; set +a; }

	if ! sh "$SETUP" start > /dev/null 2>&1; then
		echo "FAIL"
		return 1
	fi

	# Run the daemon backgrounded, but capture its stdout/stderr to a log
	# readable from the USB ACM shell for UVC Probe/Commit/STREAMON
	# diagnostics. Functional behaviour is unchanged; only the output
	# destination differs from the previous start-stop-daemon --background,
	# which discarded the daemon's output to /dev/null. The daemon runs in
	# the foreground (no self-daemonize), so $! is its real PID.
	"/usr/bin/$DAEMON" -c 0 uvc.0 -p "23 24 26" $UVC_GADGET_ARGS \
		< /dev/null > /tmp/uvc-gadget.log 2>&1 &
	echo $! > "$PIDFILE"

	# Apply the rear logo mode AFTER the daemon starts (it drives GPIO 23 high
	# at init); isight-logo overrides it per config (off/on/activity).
	( sleep 1; isight-logo "${ISIGHT_LOGO:-activity}" ) >/dev/null 2>&1 &

	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf 'Stopping %s: ' "$DAEMON"

	sh "$SETUP" stop > /dev/null 2>&1

	start-stop-daemon --stop --quiet \
		--pidfile "$PIDFILE"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	rm -f "$PIDFILE"
	return "$status"
}

restart() {
	stop
	start
}


case "$1" in
	start|stop|restart)
		"$1";;
	reload)
		restart;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
