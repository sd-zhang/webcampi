+bool HwMjpegEncoder::dequeue(struct v4l2_buffer &buf,
+			      std::chrono::steady_clock::time_point deadline)
+{
+	/* O_NONBLOCK applies to both queues. A short sleep avoids spinning on
+	 * POLLOUT when only the other mem2mem queue has completed. */
+	while (!cancelled_) {
+		if (ioctl(fd_, VIDIOC_DQBUF, &buf) == 0)
+			return true;
+		if (errno != EAGAIN && errno != EINTR)
+			return false;
+		if (std::chrono::steady_clock::now() >= deadline) {
+			++timeouts_;
+			return false;
+		}
+		std::this_thread::sleep_for(std::chrono::milliseconds(2));
+	}
+	return false;
+}
+
+void HwMjpegEncoder::resetCodec()
+{
+	/* Close even if STREAMOFF fails: never reuse a possibly queued index or
+	 * return its imported camera DMA-BUF while the old fd still owns it. */
+	stopStreaming();
+	if (fd_ != -1) {
+		close(fd_);
+		fd_ = -1;
+		++resets_;
+	}
+	releaseBuffers();
+	configured_ = false;
+}
