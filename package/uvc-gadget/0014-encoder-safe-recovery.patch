+	/* A full nonblocking pipe is already readable. Outstanding completions
+	 * are bounded by the small request pool, far below pipe capacity. */
+	if (result != 1 && !(result < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)))
+		pipeError("write", result < 0 ? errno : EIO);
