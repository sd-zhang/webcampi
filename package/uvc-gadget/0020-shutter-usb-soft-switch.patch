+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* PiSight shutter: kernel GPIO edge events, no sampling thread or timer.
+ * gpio-uapi.h is an unmodified copy of the pinned Raspberry Pi kernel UAPI
+ * (cd231d4775b14f228606c09f219b48308f6ab3aa/include/uapi/linux/gpio.h).
+ * The ARM toolchain predates GPIO v2; this header adds no runtime dependency.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include "gpio-uapi.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include "events.h"
+#include "shutter.h"
+#include "stream.h"
+
+struct shutter {
+	struct events *events;
+	struct uvc_stream *stream;
+	int fd;
+	int watching;
+	int closed;
+	char soft_connect[256];
+};
+
+static int shutter_usb(struct shutter *shutter, int closed)
+{
+	const char *command = closed ? "disconnect" : "connect";
+	int fd = open(shutter->soft_connect, O_WRONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	ssize_t count = write(fd, command, strlen(command));
+	int error = errno;
+	close(fd);
+	if (count != (ssize_t)strlen(command)) {
+		errno = count < 0 ? error : EIO;
+		return -1;
+	}
+	return 0;
+}
+
+static int shutter_apply(struct shutter *shutter)
+{
+	struct gpio_v2_line_values value = { .mask = 1 };
+	if (ioctl(shutter->fd, GPIO_V2_LINE_GET_VALUES_IOCTL, &value) < 0)
+		return -1;
+	int closed = !!(value.bits & 1);
+	if (closed == shutter->closed)
+		return 0;
+	/* Block queued STREAMON before disconnecting; unblock only on success. */
+	uvc_stream_set_shutter_closed(shutter->stream, 1);
+	if (shutter_usb(shutter, closed) < 0)
+		return -1;
+	uvc_stream_set_shutter_closed(shutter->stream, closed);
+	shutter->closed = closed;
+	fprintf(stderr, "Shutter: %s, USB %s\n", closed ? "closed" : "open",
+		closed ? "disconnected" : "connected");
+	return 0;
+}
+
+static void shutter_fault(struct shutter *shutter)
+{
+	perror("Shutter control failed; stopping capture");
+	uvc_stream_set_shutter_closed(shutter->stream, 1);
+	if (shutter_usb(shutter, 1) < 0)
+		perror("Shutter USB disconnect failed");
+	/* Exiting closes the UVC handle, deactivating the composite gadget. */
+	events_stop(shutter->events);
+}
+
+static void shutter_event(void *data)
+{
+	struct shutter *shutter = data;
+	struct gpio_v2_line_event events[16];
+	ssize_t count = read(shutter->fd, events, sizeof events);
+	if (count < 0 && (errno == EINTR || errno == EAGAIN))
+		return;
+	if (count <= 0 || count % sizeof(events[0])) {
+		if (count >= 0)
+			errno = EIO;
+		shutter_fault(shutter);
+		return;
+	}
+	/* Read the current debounced level, not a potentially stale queued edge. */
+	if (shutter_apply(shutter) < 0)
+		shutter_fault(shutter);
+}
+
+struct shutter *shutter_create(struct events *events, const char *udc)
+{
+	struct gpiochip_info chip_info = {0};
+	struct gpio_v2_line_request request = {0};
+	struct shutter *shutter = calloc(1, sizeof *shutter);
+	if (!shutter)
+		return NULL;
+	shutter->events = events;
+	shutter->fd = -1;
+	shutter->closed = -1;
+	int length = snprintf(shutter->soft_connect, sizeof shutter->soft_connect,
+		"/sys/class/udc/%s/soft_connect", udc);
+	if (length < 0 || length >= (int)sizeof shutter->soft_connect) {
+		errno = ENAMETOOLONG;
+		goto fail;
+	}
+	int chip = open("/dev/gpiochip0", O_RDONLY | O_CLOEXEC);
+	if (chip < 0)
+		goto fail;
+	if (ioctl(chip, GPIO_GET_CHIPINFO_IOCTL, &chip_info) < 0) {
+		close(chip);
+		goto fail;
+	}
+	/* Do not silently use the same line offset on an unrelated GPIO chip. */
+	if (strcmp(chip_info.label, "pinctrl-bcm2835") || chip_info.lines <= 26) {
+		close(chip);
+		errno = ENODEV;
+		goto fail;
+	}
+	request.offsets[0] = 26;
+	request.num_lines = 1;
+	strcpy(request.consumer, "pisight-shutter");
+	request.config.flags = GPIO_V2_LINE_FLAG_INPUT |
+		GPIO_V2_LINE_FLAG_EDGE_RISING | GPIO_V2_LINE_FLAG_EDGE_FALLING;
+	request.config.num_attrs = 1;
+	request.config.attrs[0].mask = 1;
+	request.config.attrs[0].attr.id = GPIO_V2_LINE_ATTR_ID_DEBOUNCE;
+	request.config.attrs[0].attr.debounce_period_us = 50000;
+	int ret = ioctl(chip, GPIO_V2_GET_LINE_IOCTL, &request);
+	int error = errno;
+	close(chip);
+	if (ret < 0) {
+		errno = error;
+		goto fail;
+	}
+	shutter->fd = request.fd;
+	if (shutter->fd >= FD_SETSIZE) {
+		errno = EMFILE;
+		goto fail;
+	}
+	/* UVC is still deactivated: keep USB off until the watcher is ready. */
+	if (shutter_usb(shutter, 1) < 0)
+		goto fail;
+	return shutter;
+fail:
+	perror("Initialize shutter");
+	shutter_destroy(shutter);
+	return NULL;
+}
+
+int shutter_start(struct shutter *shutter, struct uvc_stream *stream)
+{
+	shutter->stream = stream;
+	if (shutter_apply(shutter) < 0) {
+		shutter_fault(shutter);
+		return -1;
+	}
+	events_watch_fd(shutter->events, shutter->fd, EVENT_READ, shutter_event, shutter);
+	/* events_watch_fd has no return code; catch a failed registration. */
+	if (!FD_ISSET(shutter->fd, &shutter->events->rfds)) {
+		errno = ENOMEM;
+		shutter_fault(shutter);
+		return -1;
+	}
+	shutter->watching = 1;
+	return 0;
+}
+
+void shutter_destroy(struct shutter *shutter)
+{
+	if (!shutter)
+		return;
+	if (shutter->watching)
+		events_unwatch_fd(shutter->events, shutter->fd, EVENT_READ);
+	if (shutter->fd >= 0)
+		close(shutter->fd);
+	free(shutter);
+}
