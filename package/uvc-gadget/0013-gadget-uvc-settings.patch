+static void libcamera_source_apply_controls(struct libcamera_source *src, ControlList &controls)
+{
+	if (src->default_crop.width && src->default_crop.height &&
+	    src->camera->controls().find(&controls::ScalerCrop) != src->camera->controls().end()) {
+		const Rectangle &base = src->default_crop;
+		unsigned int width = (base.width * 100 / src->zoom) & ~1U;
+		unsigned int height = (base.height * 100 / src->zoom) & ~1U;
+		Rectangle crop(base.x + (base.width - width) / 2,
+			       base.y + (base.height - height) / 2, width, height);
+		controls.set(controls::ScalerCrop, crop);
+	}
+	if (src->camera->controls().find(&controls::ExposureValue) != src->camera->controls().end())
+		controls.set(controls::ExposureValue, src->ev_tenths / 10.0f);
+}
+
+static int libcamera_source_set_control(struct video_source *s,
+					 enum video_source_control control, int value)
+{
+	struct libcamera_source *src = to_libcamera_source(s);
+
+	switch (control) {
+	case VIDEO_SOURCE_CTRL_ZOOM:
+		if (value < 100 || value > 350)
+			return -ERANGE;
+		src->zoom = value;
+		break;
+	case VIDEO_SOURCE_CTRL_EV:
+		if (value < -20 || value > 20)
+			return -ERANGE;
+		src->ev_tenths = value;
+		break;
+	default:
+		return -EINVAL;
+	}
+	libcamera_source_apply_controls(src, src->controls);
+	return 0;
+}
