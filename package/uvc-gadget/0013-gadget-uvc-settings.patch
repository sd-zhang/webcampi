+static int uvc_store_settings(unsigned int fov, int ev, unsigned int logo,
+			      unsigned int microphone)
+{
+	static const char *const modes[] = { "off", "on", "activity" };
+	char fov_arg[4], ev_arg[5], mic_arg[2];
+	pid_t pid;
+	int status;
+
+	snprintf(fov_arg, sizeof fov_arg, "%u", fov);
+	snprintf(ev_arg, sizeof ev_arg, "%d", ev);
+	snprintf(mic_arg, sizeof mic_arg, "%u", microphone);
+	pid = fork();
+	if (pid == 0) {
+		execl("/usr/bin/isight-config-store", "isight-config-store",
+		      fov_arg, ev_arg, modes[logo], mic_arg, (char *)NULL);
+		_exit(127);
+	}
+	if (pid < 0)
+		return -1;
+	do {
+		if (waitpid(pid, &status, 0) >= 0)
+			break;
+		if (errno != EINTR)
+			return -1;
+	} while (1);
+	return WIFEXITED(status) && WEXITSTATUS(status) == 0 ? 0 : -1;
+}
+
 static void
 uvc_events_process_data(struct uvc_device *dev,
 			const struct uvc_request_data *data)
 {
+	if (dev->control_entity) {
+		if (dev->control_entity == dev->xu_unit && dev->control == 1 &&
+		    data->length == 8) {
+			int ev = (int16_t)(data->data[2] | (data->data[3] << 8));
+			unsigned int fov = data->data[1];
+			unsigned int logo = data->data[4];
+			unsigned int microphone = data->data[5];
+			if (data->data[0] == 1 && fov >= 25 && fov <= 75 &&
+			    ev >= -20 && ev <= 20 && logo <= 2 && microphone <= 1 &&
+			    !data->data[6] && !data->data[7]) {
+				if (!uvc_store_settings(fov, ev, logo, microphone)) {
+					float ratio = tanf(37.5f * 3.14159265f / 180.0f) /
+						tanf(fov * 3.14159265f / 360.0f);
+					unsigned int zoom = clamp((unsigned int)(ratio * 100.0f + 0.5f), 100U, 350U);
+					dev->fov = fov;
+					dev->saved_ev = ev;
+					dev->logo_mode = logo;
+					dev->microphone = microphone;
+					if (!uvc_stream_set_control(dev->stream, VIDEO_SOURCE_CTRL_ZOOM, zoom))
+						dev->zoom = zoom;
+					if (!uvc_stream_set_control(dev->stream, VIDEO_SOURCE_CTRL_EV, ev))
+						dev->brightness = ev;
+				} else {
+					fprintf(stderr, "failed to save PiSight settings\n");
+				}
+			}
+		} else if (data->length == 2 && dev->control_entity != dev->xu_unit) {
+			int raw = data->data[0] | (data->data[1] << 8);
+			int value = dev->control_entity == 2 ? (int16_t)raw : raw;
+			enum video_source_control control = dev->control_entity == 1 ?
+				VIDEO_SOURCE_CTRL_ZOOM : VIDEO_SOURCE_CTRL_EV;
+			if (!uvc_stream_set_control(dev->stream, control, value)) {
+				if (dev->control_entity == 1)
+					dev->zoom = value;
+				else
+					dev->brightness = value;
+			}
+		}
+		dev->control_entity = 0;
+		return;
+	}
 	const struct uvc_streaming_control *ctrl =
 		(const struct uvc_streaming_control *)&data->data;
 	struct uvc_streaming_control *target;
