Add flushed, timestamped diagnostic logging to /tmp/uvc-events.log across the
UVC control plane (lib/uvc.c) and data plane (lib/stream.c) via a shared
static-inline logger (lib/uvc-debug.h). Logs SETUP, full SET_CUR(PROBE)/
SET_CUR(COMMIT) streaming-control payloads, STREAMON/STREAMOFF, stream
start/stop, and first-frame delivery. Diagnostic only; no behaviour change.
---
--- /dev/null	2026-07-30 13:39:18.485552404 -0600
+++ b/lib/uvc-debug.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * uvc-debug.h - flushed, timestamped diagnostic logging for the UVC gadget.
+ *
+ * Writes to /tmp/uvc-events.log in append mode and flushes after every entry
+ * so the log survives stdio buffering and is readable live from the USB ACM
+ * shell. Diagnostic only; it has no effect on any functional behaviour.
+ *
+ * Defined as a static inline so both lib/uvc.c (control plane) and lib/stream.c
+ * (data plane) can log to the same file without adding a new build unit. Each
+ * translation unit keeps its own append-mode handle; O_APPEND keeps writes
+ * ordered at end-of-file and the microsecond timestamps disambiguate them.
+ */
+
+#ifndef __UVC_DEBUG_H__
+#define __UVC_DEBUG_H__
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <sys/time.h>
+
+__attribute__((format(printf, 1, 2)))
+static inline void uvc_log(const char *fmt, ...)
+{
+	static FILE *logfp;
+	struct timeval tv;
+	va_list ap;
+
+	if (!logfp) {
+		logfp = fopen("/tmp/uvc-events.log", "a");
+		if (!logfp)
+			return;
+	}
+
+	gettimeofday(&tv, NULL);
+	fprintf(logfp, "[%ld.%06ld] ", (long)tv.tv_sec, (long)tv.tv_usec);
+
+	va_start(ap, fmt);
+	vfprintf(logfp, fmt, ap);
+	va_end(ap);
+	fflush(logfp);
+}
+
+#endif /* __UVC_DEBUG_H__ */
